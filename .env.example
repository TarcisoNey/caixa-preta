# Copie este arquivo para .env e preencha com a sua chave (o .env NAO vai para o Git)
GEMINI_API_KEY=

# Opcional: troca o modelo sem mexer no codigo (padrao: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: modelo local do Whisper (padrao: small). tiny e mais rapido, mas erra muito em portugues
WHISPER_MODEL=small
